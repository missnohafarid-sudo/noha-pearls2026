{
  "name": "noha-pearls",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "admin:2fa": "node scripts/admin-2fa.mjs",
    "vendor:aruco": "node scripts/vendor-aruco.mjs",
    "test:server": "vitest run --config vitest.server.config.ts",
    "types:server": "wrangler types",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:stress": "node scripts/stress.mjs",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs quick",
    "ship": "node scripts/ship.mjs",
    "undo": "node scripts/undo.mjs",
    "discard": "node scripts/discard.mjs",
    "deployed": "node scripts/deployed.mjs",
    "guard:verify": "node scripts/guard.mjs verify",
    "guard:init": "node scripts/guard.mjs init",
    "guard:accept": "node scripts/guard.mjs accept",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "js-aruco2": "^2.0.0",
    "puppeteer": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
